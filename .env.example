# =============================================================================
# Movie Reservation System — Environment Variables
# =============================================================================
# Copy file ini menjadi .env.local dan isi dengan nilai yang sesuai.
# JANGAN commit .env.local ke repository.
# =============================================================================

# --- Firebase Admin SDK (Server-side) ----------------------------------------
# Dapatkan dari Firebase Console > Project Settings > Service Accounts > Generate new private key
# Opsi 1 (Direkomendasikan di Vercel — 1 baris string Base64 tanpa masalah escaping):
# Encode serviceAccountKey.json ke base64: [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json

# Opsi 2 (Variabel individual):
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- JWT Authentication -------------------------------------------------------
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-and-secure-jwt-secret-at-least-64-characters
JWT_REFRESH_SECRET=another-very-long-and-secure-refresh-token-secret-64-chars

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
APP_VERSION=1.0.0

# --- Payment (untuk production - isi sesuai provider) -------------------------
# MIDTRANS_SERVER_KEY=your-midtrans-server-key
# MIDTRANS_CLIENT_KEY=your-midtrans-client-key
# XENDIT_SECRET_KEY=your-xendit-secret-key

# --- CORS (untuk production) --------------------------------------------------
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
